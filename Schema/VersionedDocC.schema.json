{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DocCLab/VersionedDocC/0.0.19/Schema/VersionedDocC.schema.json",
  "title": "VersionedDocC configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "catalogPath",
    "hostingBasePath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentationOnly": {
      "type": "boolean",
      "default": false,
      "description": "Build a standalone DocC catalog without SwiftPM or symbol graphs."
    },
    "projectName": { "type": "string", "minLength": 1 },
    "moduleName": { "type": "string", "minLength": 1 },
    "modulePath": { "type": "string", "minLength": 1 },
    "targetName": { "type": "string", "minLength": 1 },
    "catalogPath": { "type": "string", "minLength": 1 },
    "additionalModules": {
      "type": "array",
      "description": "Additional modules converted from externally produced symbol graphs and merged into each version's DocC archive.",
      "items": {
        "type": "object",
        "required": ["moduleName", "symbolGraphPath"],
        "properties": {
          "moduleName": { "type": "string", "minLength": 1 },
          "modulePath": { "type": "string", "minLength": 1 },
          "symbolGraphPath": {
            "type": "string",
            "minLength": 1,
            "description": "File or directory containing symbol graphs. Supports {version}, {ref}, {commit}, and {module} placeholders."
          },
          "catalogPath": { "type": "string", "minLength": 1 },
          "sourceRepository": {
            "type": "string",
            "format": "uri",
            "description": "GitHub repository for this module when its sources live outside the primary package repository. Requires sourceRoot."
          },
          "sourceRoot": {
            "type": "string",
            "minLength": 1,
            "description": "Path to this module's prepared Git checkout, relative to the primary prepared checkout. Requires sourceRepository. The checkout's exact Git revision is used for source and Edit links."
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "sourceRepository": ["sourceRoot"],
          "sourceRoot": ["sourceRepository"]
        }
      },
      "default": []
    },
    "hostingBasePath": {
      "type": "string",
      "description": "Public URL prefix. Use / when publishing at a domain root.",
      "pattern": "^/[A-Za-z0-9._/-]*$"
    },
    "defaultVersion": { "type": "string", "default": "main" },
    "outputPath": { "type": "string" },
    "cachePath": { "type": "string" },
    "sourceRepository": { "type": "string", "format": "uri" },
    "developmentSourceRef": { "type": "string", "default": "main" },
    "siteUI": {
      "type": "object",
      "description": "Optional GitHub page actions and VersionedDocC branding.",
      "properties": {
        "showEdit": {
          "type": "boolean",
          "description": "Show Edit this page when sourceRepository is configured. Defaults to true with a source repository and false otherwise."
        },
        "showStar": {
          "type": "boolean",
          "description": "Show Star on GitHub when sourceRepository is configured. Defaults to true with a source repository and false otherwise."
        },
        "showPoweredBy": {
          "type": "boolean",
          "default": true,
          "description": "Show the Powered by VersionedDocC footer link."
        }
      },
      "additionalProperties": false
    },
    "historicalCatalogFallback": { "enum": ["current"] },
    "versions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "ref"],
        "properties": {
          "name": { "type": "string" },
          "ref": { "type": "string" },
          "sourceRef": { "type": "string" },
          "catalogPath": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "releasePolicy": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Number of releases selected according to latestStrategy."
        },
        "latestStrategy": {
          "enum": ["majorMinor", "semanticVersion", "tagDate"],
          "default": "majorMinor",
          "description": "Select the highest patch from distinct major.minor series, the highest semantic versions, or the most recently created Git tags."
        },
        "development": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "default": "main" },
            "ref": { "type": "string", "default": "HEAD" }
          }
        },
        "pinned": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "ociCache": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pull": { "type": "boolean", "default": true },
        "includeDevelopment": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "symbolGraph": {
      "type": "object",
      "properties": {
        "minimumAccessLevel": { "type": "string", "default": "public" },
        "skipProtocolImplementations": { "type": "boolean", "default": true },
        "emitExtensionBlocks": { "type": "boolean", "default": false },
        "defaultPlatform": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "triple"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "triple": { "type": "string", "minLength": 1 },
              "sdk": { "type": "string", "minLength": 1 },
              "swiftSDK": { "type": "string", "minLength": 1 },
              "buildArguments": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "apiChanges": {
      "type": "object",
      "properties": {
        "pageSize": { "type": "integer", "minimum": 1, "default": 10 }
      },
      "additionalProperties": false
    },
    "articleChanges": {
      "type": "object",
      "description": "Opt in to adjacent-version changes for authored DocC articles.",
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "allowedModules": { "type": "array", "items": { "type": "string" } },
    "environment": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "localDependencies": { "type": "object", "additionalProperties": { "type": "string" } },
    "buildArguments": { "type": "array", "items": { "type": "string" } },
    "doccArguments": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "required": ["documentationOnly"],
        "properties": { "documentationOnly": { "const": true } }
      },
      "then": {
        "required": ["modulePath"],
        "properties": { "additionalModules": { "maxItems": 0 } }
      },
      "else": { "required": ["moduleName", "targetName"] }
    },
    {
      "oneOf": [
        { "required": ["versions"] },
        { "required": ["releasePolicy"] }
      ]
    },
    {
      "if": { "not": { "required": ["sourceRepository"] } },
      "then": {
        "properties": {
          "siteUI": {
            "properties": {
              "showEdit": { "const": false },
              "showStar": { "const": false }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
