{
  "$schema": "https://raw.githubusercontent.com/DocCLab/VersionedDocC/0.0.17/Schema/VersionedDocC.schema.json",
  "schemaVersion": 1,
  "documentationOnly": true,
  "projectName": "VersionedDocC",
  "modulePath": "versioneddocc",
  "catalogPath": "Documentation/VersionedDocC.docc",
  "hostingBasePath": "/VersionedDocC",
  "defaultVersion": "main",
  "historicalCatalogFallback": "current",
  "articleChanges": {
    "enabled": true
  },
  "siteUI": {
    "showEdit": true,
    "showStar": true,
    "showPoweredBy": true
  },
  "releasePolicy": {
    "latest": 1,
    "latestStrategy": "semanticVersion",
    "development": {
      "name": "main",
      "ref": "HEAD"
    }
  },
  "sourceRepository": "https://github.com/DocCLab/VersionedDocC"
}
